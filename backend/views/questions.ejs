<!DOCTYPE html>
<html lang="en">
  <%- include("header", { title: "Stack Overclone: All Questions" }) %>
  <body>
    <main class="container-lg mt-5">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>All Questions</h1>
        <a href="/questions/ask" class="btn btn-primary btn-lg rounded-pill">Ask Question</a>
      </div>

      <!-- Filters -->
      <form method="GET" action="/questions" class="mb-3 d-flex gap-2">
        <select name="sort" class="form-select" onchange="this.form.submit()">
          <option value="">---Sort By---</option>
          <option value="Most Recent" <%= query.sort === 'recent' ? 'selected' : '' %>>Most Recent</option>
          <option value="Hot" <%= query.sort === 'hot' ? 'selected' : '' %>>Hot</option>
        </select>
        <input type="text" name="tag" class="form-control" placeholder="Filter by tag (e.g. javascript)" value="<%= query.tag || '' %>"/>
        <button type="submit" class="btn btn-primary rounded-pill">Apply</button>
      </form>

      <!-- Active Filters -->
      <% if (query.sort || query.tag) { %>
        <p class="text-muted mb-4">
          <% if (query.sort) { %><strong>Sort:</strong> <%= query.sort %><% } %>
          <% if (query.sort && query.tag) { %> | <% } %>
          <% if (query.tag) { %><strong>Tag:</strong> "<%= query.tag %>"<% } %>
          &nbsp; <a href="/questions" class="text-danger text-decoration-none">(Clear)</a>
        </p>
      <% } %>

      <!-- Questions List -->
      <div class="row">
        <div class="col-md-12">
          <% if (questions && questions.length > 0) { %>
            <% questions.forEach(q => { %>
                <div 
                class="card mb-3 shadow-sm px-3 py-2 position-relative"
                style="cursor: pointer;" 
                onclick="location.href='/questions/<%= q._id %>'"
              >
                <!-- Title -->
                <h3 class="mb-1"><%= q.title %></h3>
              
                <!-- Problem -->
                <p class="text-dark mb-2"><%= q.problem %></p>
              
                <!-- Bottom Row -->
                <div class="row align-items-center">
                  <!-- Tags -->
                  <div class="col-md-4">
                    <% q.tags?.forEach(tag => { %>
                      <a 
                        href="/questions?tag=<%= tag %>" 
                        class="badge bg-secondary text-decoration-none me-1"
                        onclick="event.stopPropagation()"
                      ><%= tag %></a>
                    <% }) %>
                  </div>
              
                  <!-- Asked By -->
                  <div class="col-md-4 text-center">
                    <small class="text-muted">
                      <a 
                        href="/users/<%= q.userId %>" 
                        class="text-decoration-none"
                        onclick="event.stopPropagation()"
                      >
                        Asked by:
                        <% if (q.username) { %>
                          <span><%= q.username %></span>
                        <% } else { %>
                          <span class="text-muted">anonymous</span>
                        <% } %>
                      </a>
                    </small>
                  </div>
              
                  <!-- Date + Votes -->
                  <div class="col-md-4 text-end">
                    <small class="text-muted d-block mb-1">
                      <%= new Date(q.created).toLocaleString("en-GB", {
                        day: "numeric", month: "numeric", year: "numeric",
                        hour: "numeric", minute: "numeric", hour12: true,
                        timeZone: "Asia/Singapore"
                      }) %>
                    </small>
                    <div>
                      <button class="btn btn-sm btn-outline-success disabled" disabled onclick="event.stopPropagation()">▲ <%= q.upvotes?.length || 0 %></button>
                      <button class="btn btn-sm btn-outline-danger disabled" disabled onclick="event.stopPropagation()">▼ <%= q.downvotes?.length || 0 %></button>
                    </div>
                  </div>
                </div>
              </div>
              
  
            <% }) %>
          <% } else { %>
            <p class="text-muted">No questions found.</p>
          <% } %>
        </div>
      </div>
    </main>

    <%- include("footer") %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
