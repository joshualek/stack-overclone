<!DOCTYPE html>
<html lang="en">
  <%- include("header", { title: "Welcome to Stack Overclone" }) %>
  <body>
    <main class="container py-5 text-center">

      <!-- Hero Section -->
      <section class="mb-5">
        <h1 class="display-4 fw-bold mb-3">Welcome to Stack Overclone</h1>
        <p class="lead mb-4">A collaborative Q&A platform for developers, students, and tech enthusiasts. Ask questions, share knowledge, and grow together.</p>
        <div class="d-flex justify-content-center gap-3">
            <% if (!user) { %>
              <a href="/questions" class="btn btn-outline-secondary btn-lg rounded-pill">Browse Questions</a>
              <a href="/register" class="btn btn-primary btn-lg rounded-pill">Join Now</a>
            <% } else { %>
                <a href="/questions" class="btn btn-primary btn-lg rounded-pill">Browse Questions</a>
            <% } %>
        </div>
      </section>

      <!-- Features -->
      <section class="row text-start justify-content-center">
        <div class="col-md-3">
          <h4>🙋 Ask Anything</h4>
          <p>Have a technical problem or curious question? Post it and get help from the community.</p>
        </div>
        <div class="col-md-3">
          <h4>💬 Share Your Knowledge</h4>
          <p>Answer questions, upvote good content, and earn reputation as a helpful contributor.</p>
        </div>
        <div class="col-md-3">
          <h4>📊 Community Driven</h4>
          <p>Our platform grows with you. The more you engage, the better your experience becomes.</p>
        </div>
      </section>

      <!-- Footer CTA -->
      <% if (!user) { %>
        <section class="mt-5">
          <p class="text-muted">Ready to dive in?</p>
          <a href="/register" class="btn btn-dark rounded-pill px-4 py-2">Create Your Account</a>
        </section>
      <% } %>
    </main>

    <%- include("footer") %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
