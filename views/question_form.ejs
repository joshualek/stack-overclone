<!DOCTYPE html>
<html lang="en">
  <%- include("header", { title: "Ask a Question" }) %>
  <body>
    <main class="container-lg mt-5">
      <h1 class="mb-4">Ask a Question</h1>

      <form method="POST" action="/questions/ask">
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            type="text"
            class="form-control"
            id="title"
            name="title"
            placeholder="Enter your question title"
            required
          />
        </div>

        <div class="mb-3">
          <label for="problem" class="form-label">Problem</label>
          <textarea
            class="form-control"
            id="problem"
            name="problem"
            rows="4"
            placeholder="Describe your problem clearly"
            required
          ></textarea>
        </div>

        <div class="mb-3">
          <label for="tags" class="form-label">Tags (comma-separated)</label>
          <input
            type="text"
            class="form-control"
            id="tags"
            name="tags"
            placeholder="e.g. javascript, node.js, express"
          />
        </div>

        <input type="hidden" name="userId" value="<%= user?._id %>" />

        <button type="submit" class="btn btn-primary rounded-pill">Post Question</button>
      </form>
    </main>

    <%- include("footer") %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
