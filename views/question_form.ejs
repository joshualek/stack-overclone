<!DOCTYPE html>
<html lang="en">
    <%- include ("header", {title: "Stack Overclone: Ask Question"}) %>
<body>
    <main class="container-lg">
        <!-- Main content goes here -->
        <h1>Ask New Question</h1>
        <form method="POST" action="/questions/add">
            <div class="mb-3">
            <label for="title-input" class="form-label"><h3>Title</h3></label>
            <p>Be specific and imagine you are asking a question to another person</p>
            <input type="text" class="form-control" id="title-input" name="title" required>
            </div>
            <div class="mb-3">
            <label for="problem-input" class="form-label"><h3>Problem</h3></label>
            <p>Include all the information someone would need to answer your question</p>
            <textarea class="form-control" id="problem-input" name="problem" rows="3" required></textarea>
            </div>
            <div class="mb-3">
            <label for="tags-input" class="form-label"><h3>Tag</h3></label>
            <p>Separate different tags with commas, eg. tag 1, tag 2, tag 3</p>
            <input type="text" class="form-control" id="tags-input" name="tags" required>
            </div>
            <input type="hidden" name="userId" value="<%= user._id %>">
            <button type="submit" class="btn btn-primary rounded-pill" id="ask-question-btn">Ask Question</button>
        </form>
        </main>
        <%- include ("footer") %>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>