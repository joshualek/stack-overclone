<!DOCTYPE html>
<html lang="en">
  <%- include ("header", {title: "Stack Overclone: Questions"}) %>
  <body>
    <main class="container-lg">
      <!-- Main content goes here -->
      <h1>Questions</h1>
      <button
        type="button"
        class="btn btn-primary rounded-pill"
        id="ask-question-btn"
        onclick="window.location.href='/questions/new'"
      >
        Ask Question
      </button>
      <div class="list-group mt-3">
        <% questions.forEach((question) => { %>
        <a
          href="/questions/<%= question._id %>"
          class="list-group-item list-group-item-action"
        >
          <div class="d-flex w-100 justify-content-between">
            <h5 class="mb-1"><%= question.title %></h5>
            <small><%= question.tags.join(", ") %></small>
            <small><%= new Date(question.created).toLocaleString('en-GB', { day: 'numeric', month: 'numeric', year: 'numeric', hour: 'numeric', minute: 'numeric', hour12: true, timeZone: 'Asia/Singapore' }) %></small>
        </div>
          <p class="mb-1"><%= question.problem %></p>
          <% if (question.username) { %>
            <small class="text-success"><%= question.username %></small>
          <% } else { %>
            <small class="text-muted">anonymous</small>
          <% } %>
        </a>
        <% }) %>
      </div>
    </main>
    <%- include ("footer") %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
