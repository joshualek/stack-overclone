<!DOCTYPE html>
<html lang="en">
  <%- include("header", { title: "Stack Overclone: Question" }) %>
  <body>
    <main class="container-lg">

      <!-- Question Display -->
      <h1><%= question.title %></h1>
      <p><%= question.problem %></p>
      <p>Tags: <%= question.tags.join(", ") %></p>
      <p>Created: <%= new Date(question.created).toLocaleString('en-GB', { day: 'numeric', month: 'numeric', year: 'numeric', hour: 'numeric', minute: 'numeric', hour12: true, timeZone: 'Asia/Singapore' }) %></p>
      <p>Asked by: <%= question.username %></p>

      <div class="d-flex align-items-center gap-2">
        <% const upVotes = question.upvotes ? question.upvotes.length : 0; %>
        <% const downVotes = question.downvotes ? question.downvotes.length : 0; %>
      
        <% if (user && user._id && user._id.toString() !== question.userId.toString()) { %>
          <!-- Logged-in user can vote -->
        <form method="POST" action="/questions/<%= question._id %>/vote/" style="display: inline;">
            <input type="hidden" name="voteType" value="up">
            <button type="submit" class="btn btn-outline-success">▲ <%= upVotes %></button>
        </form>
        <form method="POST" action="/questions/<%= question._id %>/vote/" style="display: inline;">
            <input type="hidden" name="voteType" value="down">
            <button type="submit" class="btn btn-outline-danger">▼ <%= downVotes %></button>
        </form>
        <span class="ms-2">Overall: <%= upVotes - downVotes %></span>
        <% } else if (user && user._id && question.userId && user._id.toString() === question.userId.toString()) { %>
            <a href="/questions/<%= question._id %>/" class="btn btn-sm btn-outline-success position-relative z-1 disabled-link mb-2">▲ <%= upVotes %></a>
            <a href="/questions/<%= question._id %>/" class="btn btn-sm btn-outline-danger position-relative z-1 disabled-link mb-2">▼ <%= downVotes %></a>
        <% } else { %>
            <a href="/login" class="btn btn-sm btn-outline-success position-relative z-1 disabled-link">▲ <%= upVotes %></a>
            <a href="/login" class="btn btn-sm btn-outline-danger position-relative z-1 disabled-link" >▼ <%= downVotes %></a>
        <% } %>
      </div>
      

      <!-- Edit/Delete Buttons for Question Owner -->
      <% if (user && user._id.toString() === question.userId.toString()) { %>
        <div class="d-flex gap-2"></div>
            <button type="button" class="btn btn-primary rounded-pill" id="edit-question-btn">Edit</button>
            <form method="POST" action="/questions/<%= question._id %>/delete" style="display: inline;">
            <input type="submit" class="btn btn-danger rounded-pill" value="Delete">
            </form>
        </div>
        <!-- Edit Question Form, only appears upon clicking Edit -->
        <div class="row" id="edit-question-form" style="display: none;">
          <div class="col-md-6">
            <form method="POST" action="/questions/<%= question._id %>/edit">
              <div class="mb-3">
                <label for="title-input" class="form-label">Title</label>
                <input type="text" class="form-control" name="title" value="<%= question.title %>">
              </div>
              <div class="mb-3">
                <label for="problem-input" class="form-label">Problem</label>
                <input type="text" class="form-control" name="problem" value="<%= question.problem %>">
              </div>
              <div class="mb-3">
                <label for="tags-input" class="form-label">Tags</label>
                <input type="text" class="form-control" name="tags" value="<%= question.tags.join(", ") %>">
              </div>
              <button type="submit" class="btn btn-success rounded-pill">Save</button>
              <button type="button" class="btn btn-secondary rounded-pill" id="cancel-edit-btn">Cancel</button>
            </form>
          </div>
        </div>
      <% } %>

      <hr>

      <!-- Answers Section -->
      <h2>Answers</h2>
      <% if (question.answers?.length > 0) { %>
        <% question.answers.forEach(answer => { %>
          <div class="card mb-3">
            <div class="card-body">
              <p><%= answer.body %></p>
              <p>Answered by: <%= answer.username %></p>
              <p>On: <%= new Date(answer.created).toLocaleString('en-GB', { day: 'numeric', month: 'numeric', year: 'numeric', hour: 'numeric', minute: 'numeric', hour12: true, timeZone: 'Asia/Singapore' }) %></p>

              <% const isMyAnswer = user && user._id.toString() === answer.userId.toString(); %>
              
              <!-- Voting for others’ answers -->
                <div class="d-flex align-items-center gap-2">
                    <% const upVotes = answer.upvotes ? answer.upvotes.length : 0; %>
                    <% const downVotes = answer.downvotes ? answer.downvotes.length : 0; %>
                  
                    <% if (!isMyAnswer && user) { %>
                      <!-- Logged-in user can vote -->
                    <form method="POST" action="/questions/<%= question._id %>/answers/<%= answer._id %>/vote/" style="display: inline;">
                        <input type="hidden" name="voteType" value="up">
                        <button type="submit" class="btn btn-outline-success">▲ <%= upVotes %></button>
                    </form>
                    <form method="POST" action="/questions/<%= question._id %>/answers/<%= answer._id %>/vote/" style="display: inline;">
                        <input type="hidden" name="voteType" value="down">
                        <button type="submit" class="btn btn-outline-danger">▼ <%= downVotes %></button>
                    </form>
                    <span class="ms-2">Overall: <%= upVotes - downVotes %></span>
                    <% } else if (user && user._id && question.userId && user._id.toString() === question.userId.toString()) { %>
                        <a href="/questions/<%= question._id %>/" class="btn btn-sm btn-outline-success position-relative z-1 disabled-link mb-2">▲ <%= upVotes %></a>
                        <a href="/questions/<%= question._id %>/" class="btn btn-sm btn-outline-danger position-relative z-1 disabled-link mb-2">▼ <%= downVotes %></a>
                    <% } else { %>
                      <!-- Not logged in or voting on own question -->
                      <a href="/login" class="btn btn-sm btn-outline-success disabled-link">▲ <%= upVotes %></a>
                      <a href="/login" class="btn btn-sm btn-outline-danger disabled-link">▼ <%= downVotes %></a>
                    <% } %>
                  </div>

              <!-- Edit/Delete buttons and hidden form -->
              <% if (isMyAnswer) { %>
                <button type="button" class="btn btn-primary rounded-pill" id="edit-answer-btn-<%= answer._id %>">Edit</button>
                <form method="POST" action="/questions/<%= question._id %>/answers/<%= answer._id %>/delete" style="display: inline;">
                  <input type="submit" class="btn btn-danger rounded-pill" value="Delete">
                </form>

                <div class="mt-3" id="edit-answer-form-<%= answer._id %>" style="display: none;">
                  <form method="POST" action="/questions/<%= question._id %>/answers/<%= answer._id %>/edit">
                    <div class="mb-3">
                      <label class="form-label">Edit your answer:</label>
                      <textarea class="form-control" name="updatedAnswer" rows="3"><%= answer.body %></textarea>
                    </div>
                    <button type="submit" class="btn btn-success rounded-pill">Save</button>
                    <button type="button" class="btn btn-secondary rounded-pill cancel-edit-answer-btn" data-answer-id="<%= answer._id %>">Cancel</button>
                  </form>
                </div>

                <script>
                  document.addEventListener("DOMContentLoaded", () => {
                    document.getElementById("edit-answer-btn-<%= answer._id %>").addEventListener("click", function () {
                      document.getElementById("edit-answer-form-<%= answer._id %>").style.display = "block";
                      this.style.display = "none";
                    });
                    document.querySelector(`#edit-answer-form-<%= answer._id %> .cancel-edit-answer-btn`).addEventListener("click", function () {
                      document.getElementById("edit-answer-form-<%= answer._id %>").style.display = "none";
                      document.getElementById("edit-answer-btn-<%= answer._id %>").style.display = "inline-block";
                    });
                  });
                </script>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <p>No answers yet. Be the first to respond!</p>
      <% } %>

      <!-- Your Answer Form -->
      <h2>Your Answer</h2>
      <% if (user && user._id) { %>
        <form method="POST" action="/questions/<%= question._id %>/answers/add">
          <div class="mb-3">
            <textarea class="form-control" name="answer" rows="3" required></textarea>
          </div>
          <input type="hidden" name="userId" value="<%= user._id %>">
          <button type="submit" class="btn btn-primary rounded-pill">Post Answer</button>
        </form>
      <% } else { %>
        <p>Please <a href="/login"><span class="--bs-primary">login</span></a> to post an answer.</p>
      <% } %>

    </main>

    <script>
      // Edit Question JS
      document.addEventListener("DOMContentLoaded", () => {
        const editBtn = document.getElementById("edit-question-btn");
        const cancelBtn = document.getElementById("cancel-edit-btn");
        const form = document.getElementById("edit-question-form");

        if (editBtn && cancelBtn && form) {
          editBtn.addEventListener("click", () => {
            form.style.display = "block";
            editBtn.style.display = "none";
          });

          cancelBtn.addEventListener("click", () => {
            form.style.display = "none";
            editBtn.style.display = "inline-block";
          });
        }
      });
    </script>

    <%- include("footer") %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
